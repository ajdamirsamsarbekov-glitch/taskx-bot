# Environment Variables

# Database
DATABASE_URL=postgresql://taskx:taskx_password@localhost:5432/taskx
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=taskx
DATABASE_PASSWORD=taskx_password
DATABASE_NAME=taskx

# Redis
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# Telegram Bot
BOT_TOKEN=your_bot_token_here
TELEGRAM_WEBHOOK_URL=https://yourdomain.com/webhook

# JWT
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# Admin
ADMIN_SECRET=your_admin_secret_here
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin_password_change_this

# Payment
PAYMENT_PROVIDER=mock
PAYMENT_API_KEY=your_payment_api_key_here

# Platform Settings
PLATFORM_FEE_PERCENT=30
AUTO_COMPLETE_HOURS=24
MIN_TASK_PRICE=50
MAX_TASK_PRICE=50000

# Storage (MinIO/S3)
STORAGE_ENDPOINT=localhost
STORAGE_PORT=9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=taskx-files
STORAGE_USE_SSL=false

# App URLs
API_URL=http://localhost:3000
WEB_URL=http://localhost:3001
ADMIN_URL=http://localhost:3002

# Environment
NODE_ENV=development
PORT=3000
